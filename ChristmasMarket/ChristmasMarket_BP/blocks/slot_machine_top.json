{
  "format_version": "1.21.40",
  "minecraft:block": {
    "description": {
      "identifier": "market:slot_machine_top",
      "menu_category": {
        "category": "none",
        "is_hidden_in_commands": true
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": [
            "minecraft:cardinal_direction"
          ],
          "y_rotation_offset": 180
        }
      },
      "states": {
        "market:spin": [
          0,
          1,
          2,
          3
        ],
        "market:lever": [
          0,
          1
        ]
      }
    },
    "components": {
      "minecraft:geometry": {
        "identifier": "geometry.market_slot_machine_top",
        "bone_visibility": {
          "r0": "q.block_state('market:spin') == 0",
          "r1": "q.block_state('market:spin') == 1",
          "r2": "q.block_state('market:spin') == 2",
          "r3": "q.block_state('market:spin') == 3",
          "l0": "q.block_state('market:lever') == 0",
          "l1": "q.block_state('market:lever') == 1"
        }
      },
      "minecraft:material_instances": {
        "*": {
          "texture": "market_palette",
          "render_method": "alpha_test"
        },
        "glow": {
          "texture": "market_palette",
          "render_method": "alpha_test",
          "face_dimming": false,
          "ambient_occlusion": false
        }
      },
      "minecraft:collision_box": {
        "origin": [
          -7,
          0,
          -6
        ],
        "size": [
          14,
          16,
          12
        ]
      },
      "minecraft:selection_box": {
        "origin": [
          -7,
          0,
          -6
        ],
        "size": [
          14,
          16,
          12
        ]
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 1.5
      },
      "minecraft:light_emission": 9,
      "minecraft:loot": "loot_tables/empty.json",
      "minecraft:custom_components": [
        "market:coin_press"
      ]
    },
    "permutations": [
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              0,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              90,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              180,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              270,
              0
            ]
          }
        }
      }
    ]
  }
}
