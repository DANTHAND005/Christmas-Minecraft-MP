{
  "format_version": "1.21.40",
  "minecraft:block": {
    "description": {
      "identifier": "santa:icicle_lights",
      "menu_category": {
        "category": "items"
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": [
            "minecraft:cardinal_direction"
          ],
          "y_rotation_offset": 180
        }
      },
