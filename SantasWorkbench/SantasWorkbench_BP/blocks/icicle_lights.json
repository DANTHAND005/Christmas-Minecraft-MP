        "condition": "q.block_state('santa:on') == 0",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "santa_decor",
              "render_method": "alpha_test"
            },
            "glow": {
              "texture": "santa_decor",
              "render_method": "alpha_test",
              "face_dimming": true,
              "ambient_occlusion": false
            }
          },
          "minecraft:light_emission": 0
