{
 "format_version": "1.8.0",
 "render_controllers": {
  "controller.render.xmas.default": {
   "geometry": "Geometry.default",
   "materials": [
    {
     "*": "Material.default"
    }
   ],
   "textures": [
    "Texture.default"
   ]
  },
  "controller.render.xmas.reindeer": {
   "arrays": {
    "textures": {
     "Array.skins": [
      "Texture.default",
      "Texture.rudolph"
     ]
    }
   },
   "geometry": "Geometry.default",
   "materials": [
    {
     "*": "Material.default"
    }
   ],
   "textures": [
    "Array.skins[query.variant]"
   ],
   "part_visibility": [
    {
     "*": true
    },
    {
     "saddle": "query.is_saddled"
    }
   ]
  },
  "controller.render.xmas.seal": {
   "geometry": "Geometry.default",
   "materials": [
    {
     "*": "Material.default"
    }
   ],
   "textures": [
    "query.is_baby ? Texture.pup : Texture.default"
   ]
  },
  "controller.render.xmas.reindeer_sleigh": {
   "geometry": "Geometry.sleigh",
   "materials": [
    {
     "*": "Material.sleigh"
    }
   ],
   "textures": [
    "Texture.sleigh"
   ]
  }
 }
}