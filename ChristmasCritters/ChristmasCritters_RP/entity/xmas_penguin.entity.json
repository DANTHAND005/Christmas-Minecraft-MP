{
 "format_version": "1.10.0",
 "minecraft:client_entity": {
  "description": {
   "identifier": "xmas:penguin",
   "materials": {
    "default": "entity_alphatest"
   },
   "textures": {
    "default": "textures/entity/xmas/penguin"
   },
   "geometry": {
    "default": "geometry.xmas.penguin"
   },
   "animations": {
    "look": "animation.xmas.look",
    "walk": "animation.xmas.penguin_walk",
    "slide": "animation.xmas.penguin_slide",
    "sit": "animation.xmas.penguin_sit"
   },
   "scripts": {
    "animate": [
     "look",
     {
      "walk": "!query.property('xmas:sitting') && !query.property('xmas:sliding')"
     },
     {
      "slide": "query.property('xmas:sliding')"
     },
     {
      "sit": "query.property('xmas:sitting')"
     }
    ],
    "scale": "query.is_baby ? 0.55 : 1.0"
   },
   "render_controllers": [
    "controller.render.xmas.default"
   ],
   "spawn_egg": {
    "texture": "xmas_penguin_egg",
    "texture_index": 0
   }
  }
 }
}