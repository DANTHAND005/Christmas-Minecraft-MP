{
  "namespace": "hud",
  "progress_text_label": {
    "type": "label",
    "shadow": true,
    "text": "#level_number",
    "color": "$experience_text_color",
    "anchor_from": "top_middle",
    "anchor_to": "bottom_middle",
    "bindings": [
      {
        "binding_name": "#level_number",
        "binding_type": "global"
      },
      {
        "binding_name": "#level_number_visible",
        "binding_type": "global",
        "binding_name_override": "#visible"
      }
    ],
    "controls": [
      {
        "snow_cap": {
          "type": "image",
          "texture": "textures/ui/xp_snow_cap",
          "tiled": "x",
          "size": [
            "100% + 2px",
            3
          ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [
            0,
            -2
          ],
          "layer": 1
        }
      }
    ]
  }
}